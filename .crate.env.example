# Copy to .crate.env before running Docker Compose. This file contains no secrets.
# Provider credentials may be entered in the console at http://localhost:8788;
# they are encrypted in data/crate.db using data/config.key.

# Seed the first-run source layout. yt-dlp is always enabled as Tier 3.
CRATE_MONOCHROME=1
CRATE_TIDAL=1
CRATE_ARCOD=
CRATE_QOBUZ=
CRATE_OCTAVE=
CRATE_ANTRA=
CRATE_DEEZER=
CRATE_SOULSEEK=
CRATE_TELEGRAM=

# Optional provider credentials. Prefer entering these in Provider Settings.
CRATE_QOBUZ_APP_ID=
CRATE_QOBUZ_APP_SECRET=
CRATE_QOBUZ_TOKEN=
CRATE_OCTAVE_ACCOUNT_KEY=
CRATE_ANTRA_USERNAME=
CRATE_ANTRA_PASSWORD=
CRATE_DEEZER_ARL=
CRATE_SLSKD_URL=
CRATE_SLSKD_API_KEY=
CRATE_SLSKD_DOWNLOADS=/slskd-downloads
CRATE_TG_API_ID=
CRATE_TG_API_HASH=
CRATE_TG_SESSION=
CRATE_TG_BOT=

# Public provider endpoints. Change only when operating a compatible mirror.
CRATE_MONOCHROME_BASE=https://tracks.monochrome.st
CRATE_TIDAL_HIFI_BASE=https://hifi.odskyler.com
CRATE_TIDAL_AUTH_BASE=https://auth.odskyler.workers.dev
CRATE_TIDAL_CATALOG_BASE=https://api.tidal.com/v1
CRATE_OCTAVE_CATALOG_BASE=https://music.octavestreaming.com
CRATE_OCTAVE_API_BASE=https://api.octavestreaming.com
CRATE_ANTRA_BASE=https://antra.hoshi.cfd
CRATE_ARCOD_BASE=https://arcod.xyz

# Optional metadata, library, and authentication integrations.
CRATE_SPOTIFY_CLIENT_ID=
CRATE_SPOTIFY_CLIENT_SECRET=
CRATE_SPOTIFY_REDIRECT_URI=
CRATE_ACOUSTID_KEY=
CRATE_NAVIDROME_URL=
CRATE_NAVIDROME_PUBLIC_URL=
CRATE_NAVIDROME_USER=
CRATE_NAVIDROME_PASS=
CRATE_NAVIDROME_SSO_HEADER=
CRATE_OPS_API_KEY=
CRATE_SERVE_API_KEY=

# Worker tuning.
CRATE_BULK_CONCURRENCY=4
CRATE_MUX_TIER1=all
CRATE_MUX_TIER2=all
CRATE_MUX_TIER3=all
CRATE_LIBRARY_SYNC_INTERVAL=7200
CRATE_LISTEN_POLL_INTERVAL=1800
CRATE_SYNC_MAX_ENQUEUE=300
CRATE_TRASH_RETENTION_DAYS=30
CRATE_TRASH_EMPTY_INTERVAL=86400
