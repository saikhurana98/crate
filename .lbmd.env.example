# =============================================================================
# lbmd — environment template
# =============================================================================
# Copy this file to .lbmd.env (which is gitignored) and fill in real values.
# Source it before starting the service:
#     set -a; source .lbmd.env; set +a
#     pnpm --filter @lbmd/core start
#
# Convention:
#   - All env vars prefixed LBMD_
#   - Naming: LBMD_<SERVICE>_<KIND>
#   - The service fails fast at startup if a required env is missing.
#
# See SECRETS.md for how to obtain each value.
# =============================================================================

# -----------------------------------------------------------------------------
# Service runtime (required)
# -----------------------------------------------------------------------------
# Path to lbmd.config.json
LBMD_CONFIG_PATH=./config/lbmd.config.json

# Log level: debug | info | warn | error
LBMD_LOG_LEVEL=info

# Headed browser for Playwright (1=visible, leave empty for headless default)
LBMD_BROWSER_HEADED=

# Optional: enable OpenTelemetry export (leave empty to disable, zero overhead)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lbmd-core


# -----------------------------------------------------------------------------
# Metadata resolvers
# -----------------------------------------------------------------------------

# MusicBrainz — required by their API ToS
# Format: AppName/Version (contact-email)
# How: arbitrary string, no signup
LBMD_MUSICBRAINZ_USER_AGENT=lbmd/0.1 (you@example.com)

# Spotify Web API — client-credentials flow
# How: https://developer.spotify.com/dashboard → Create app
LBMD_SPOTIFY_CLIENT_ID=
LBMD_SPOTIFY_CLIENT_SECRET=

# Apple Music API — developer token (JWT)
# How: Apple Developer account → MusicKit → generate token
LBMD_APPLE_DEVELOPER_TOKEN=

# YouTube Music — path to JSON file with cookies + headers
# How: pip install ytmusicapi; ytmusicapi browser; save to a file
LBMD_YTMUSIC_AUTH_HEADERS_PATH=./creds/ytmusic-headers.json

# AcoustID — fingerprint → MBID lookup service
# How: https://acoustid.org/login → register an application → API key
LBMD_ACOUSTID_API_KEY=

# last.fm — optional cover-art fallback
# How: https://www.last.fm/api/account/create
LBMD_LASTFM_API_KEY=


# -----------------------------------------------------------------------------
# Source adapters — RIP tier (latency-optimised, lossy)
# -----------------------------------------------------------------------------

# OnTheSpot — Spotify ripper
# Use a DEDICATED Spotify account (not your primary). May be flagged.
LBMD_ONTHESPOT_USERNAME=
LBMD_ONTHESPOT_PASSWORD=

# yt-dlp wrapper for YouTube Music
# Path to yt-dlp binary (usually `which yt-dlp`); cookies optional for age-restricted
LBMD_YTDLP_BIN_PATH=/usr/bin/yt-dlp
LBMD_YTDLP_COOKIES_PATH=


# -----------------------------------------------------------------------------
# Source adapters — ENDGOAL tier (quality-optimised, FLAC)
# -----------------------------------------------------------------------------

# Squid/Qobuz mirror — typically no creds needed (public mirror)
# Override the base URL only if Squid WTF moves
LBMD_SQUID_BASE_URL=https://qobuz.squid.wtf

# Lucida — uses Playwright; may need a saved cookie/storage state path
# (Cloudflare clearance survives across requests via shared BrowserContext)
LBMD_LUCIDA_BASE_URL=https://lucida.to
LBMD_LUCIDA_STORAGE_STATE_PATH=./creds/lucida-storage.json

# Monochrome — TBD by adapter author
LBMD_MONOCHROME_BASE_URL=https://monochrome.tf
LBMD_MONOCHROME_STORAGE_STATE_PATH=./creds/monochrome-storage.json

# Soulseek — register on the Soulseek network (free)
# How: https://www.slsknet.org/
LBMD_SOULSEEK_USERNAME=
LBMD_SOULSEEK_PASSWORD=
LBMD_SOULSEEK_LISTEN_PORT=2234


# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------

# NAS root — must be a single mount; library/.tmp/ and library/<Artist>/...
# must be on the same filesystem (atomic-write invariant; see ADR-0008)
LBMD_NAS_ROOT=/mnt/nas/music

# SQLite catalog DB path (defaults to ${NAS_ROOT}/.lbmd/catalog.db if unset)
LBMD_DB_PATH=


# -----------------------------------------------------------------------------
# Network endpoints (override config defaults if needed)
# -----------------------------------------------------------------------------

# WebSocket server bind
LBMD_WS_HOST=0.0.0.0
LBMD_WS_PORT=8787

# Ops server bind (metrics + health). Local network trusted.
LBMD_OPS_HOST=0.0.0.0
LBMD_OPS_PORT=8788


# -----------------------------------------------------------------------------
# Test runtime (optional)
# -----------------------------------------------------------------------------

# Set to 1 to enable LIVE source integration tests (hits real services).
# CI runs only fake-backed tests; set this for manual pre-merge validation.
LBMD_TEST_LIVE_SOURCES=
